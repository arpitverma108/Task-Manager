# ⚠️  PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env and fill in your production values
# DO NOT commit the actual .env file to Git!

# Environment
NODE_ENV=production

# Server Port
PORT=5000

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=your_very_long_random_secret_key_here_minimum_32_characters

# Token Expiration
JWT_EXPIRES_IN=7d

# Database Path (must be persistent across restarts)
# Example: /var/lib/team-task-manager/taskmanager.db
DB_PATH=/var/lib/team-task-manager/taskmanager.db

# Frontend URL(s) - Set to your actual domain
# For multiple domains: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Session Timeout
SESSION_TIMEOUT=7d
