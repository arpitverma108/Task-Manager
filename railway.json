{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd backend && npm start",
    "restartPolicyType": "ON_FAILURE"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs"]
    },
    "build": {
      "cmds": ["cd backend && npm install --production"]
    }
  }
}